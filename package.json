{
  "name": "protosail-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Protosail — UCL Microtransat Challenge team website.",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "predev": "node scripts/ensure-model.mjs",
    "dev": "vite",
    "prebuild": "node scripts/ensure-model.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:tour": "node scripts/check-tour.mjs",
    "model": "node scripts/process-model.mjs",
    "inspect": "node scripts/inspect-model.mjs",
    "fonts": "node scripts/sync-fonts.mjs",
    "chart": "node scripts/build-chart.mjs",
    "shots": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/fragment-mono": "5.3.0",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@types/three": "0.185.4",
    "d3-geo": "^3.1.1",
    "puppeteer-core": "^25.10.0",
    "topojson-client": "^3.1.0",
    "typescript": "~5.9.3",
    "vite": "8.2.2",
    "world-atlas": "^2.0.2"
  }
}
